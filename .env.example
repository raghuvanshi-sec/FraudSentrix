# TrustLayer-X Environment Configuration
# This file serves as a template for local environment setup.
# Copy this to the appropriate directories as specified below.

# --- GLOBAL CONFIGURATION ---
NODE_ENV=development

# --- BACKEND CONFIGURATION (trustlayerx-backend/.env) ---
# Port for the Express server
PORT=3000

# MongoDB Connection String (Required for Auth & Scans)
# For local dev: mongodb://127.0.0.1:27017/trustlayer
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/trustlayer
MONGO_URI=mongodb://127.0.0.1:27017/trustlayerx

# JWT Secret Key (Used for secure session tokens)
# Generate a strong 64-character hex string for production.
JWT_SECRET=your_super_secret_64_character_hex_string

# --- ML-ENGINE CONFIGURATION (Used by ml-engine/*.py) ---
# The ML engine uses the same MONGO_URI for data loading and seeding.
# If MONGO_URI is defined at the system level or root, it will be shared.
